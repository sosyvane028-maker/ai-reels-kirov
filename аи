<script>
/* Замените на свой Telegram (без @) */
const TG_USERNAME = "YOUR_TELEGRAM";

document.getElementById('y').textContent = new Date().getFullYear();
const hd = document.getElementById('hd'), nav = document.getElementById('nav'), bg = document.getElementById('bg');
const setNav = o => { nav.classList.toggle('o', o); bg.setAttribute('aria-expanded', o); bg.textContent = o ? 'CLOSE' : 'MENU'; document.body.style.overflow = o ? 'hidden' : ''; };
bg.onclick = () => setNav(!nav.classList.contains('o'));
nav.querySelectorAll('a').forEach(a => a.onclick = () => setNav(false));

/* compact nav + subtle parallax */
const par = document.querySelector('[data-par] img'), still = matchMedia('(prefers-reduced-motion:reduce)').matches;
let tick = false;
addEventListener('scroll', () => {
  if (tick) return; tick = true;
  requestAnimationFrame(() => {
    hd.classList.toggle('c', scrollY > 40);
    if (par && !still && scrollY < innerHeight) par.style.transform = `translateY(${-scrollY * .06}px)`;
    tick = false;
  });
}, {passive:true});

/* reveal on scroll */
const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }), {threshold:.1});
document.querySelectorAll('.rv').forEach(el => io.observe(el));

/* картинки, не загрузившиеся до старта скрипта, тоже получают пометку IMAGE NEEDED */
document.querySelectorAll('.ph img').forEach(i => { if (i.complete && i.naturalWidth === 0) i.parentNode.classList.add('missing'); });

/* form → Telegram с готовым текстом */
document.getElementById('form').addEventListener('submit', e => {
  e.preventDefault();
  const f = e.target, st = document.getElementById('st');
  if (f.site.value) return;
  if (!f.name.value.trim() || !f.biz.value.trim() || !f.contact.value.trim()){ st.textContent = 'Заполните имя, бизнес и контакт.'; return; }
  const t = `Запрос с сайта AI REELS\nИмя: ${f.name.value}\nБизнес: ${f.biz.value}\nСсылка: ${f.link.value || '—'}\nБюджет: ${f.budget.value || '—'}\nЗадача: ${f.task.value || '—'}\nКонтакт: ${f.contact.value}`;
  if (navigator.clipboard) navigator.clipboard.writeText(t).catch(()=>{});
  st.textContent = 'Открываю Telegram. Текст запроса скопирован — отправьте его в чате.';
  window.open(`https://t.me/${TG_USERNAME}?text=${encodeURIComponent(t)}`, '_blank', 'noopener');
});
</script>
